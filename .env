DATABASE_URL=./db/custom.db
# Copy this file to `.env.local` and adjust as needed.

# Master switch for showing prices across the entire website.
# true  = fees shown (nav: "Pricing")  |  false = "Price on request" (nav: "Fees")
# NOTE: NEXT_PUBLIC_* values are inlined at build time — rebuild or restart
# the dev server after changing this.
NEXT_PUBLIC_SHOW_PRICING=false

# Public production URL used by deployment integrations and documentation.
NEXT_PUBLIC_SITE_URL=https://www.yaaraconsultancyservices.com

# Optional analytics. Use GA4 directly or Google Tag Manager, not both unless
# the GTM container is configured to own the GA4 tag.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=

# Optional Google Search Console HTML verification token.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
